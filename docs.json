    "tabs": [
      {
        "tab": "Instrucciones",
        "groups": [
          {
            "group": "IP Elásticas",
            "pages": [
              "readme"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      },
      {
        "tab": "Intranet FedexVB",
        "icon": "whistle",
        "href": "https://arbitros.fedexvoleibol.com/"
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Soporte",
        "href": "mailto:hola@antoniogatfdez.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Página Principal",
      "href": "https://antoniogatfdez.com"
    }
  },
  "contextual": {
